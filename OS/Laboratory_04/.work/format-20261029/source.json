          "int localCount = 0;    TlsSetValue(tlsIndex, localBuffer);    for (int i = start; i <= end; i++) {        if (isPrime(i)) {            int* buf = (int*)TlsGetValue(tlsIndex);            buf[localCount] = i;            localCount++;        }    }    int* finalBuf = (int*)TlsGetValue(tlsIndex);    for (int i = 0; i < localCount; i++) {        globalPrimes[globalIndex] = finalBuf[i];        int temp = globalIndex;        Sleep(1);        globalIndex = temp + 1;    }    free(finalBuf);"
        ]
      ]
    },
    {
      "body": 290,
      "cells": [
        [
          "struct LocalData {    int* buffer;    int count;};pthread_once_t once_control = PTHREAD_ONCE_INIT;pthread_key_t tlsKey;int tls_error = 0;void destroy_tls(void* pointer) {    LocalData* data = static_cast<LocalData*>(pointer);    if (data) {        free(data->buffer);        free(data);    }}void init_tls() {    tls_error = pthread_key_create(&tlsKey, destroy_tls);}"
        ]
      ]
    },
    {
      "body": 295,
      "cells": [
        [
          "void WINAPI FiberFunc(LPVOID lpParameter) {    while (keep_running.load(std::memory_order_relaxed)) {        long long start = current_n;        current_n += CHUNK_SIZE;        double partial_sum = 0.0;        for (long long i = start; i < start + CHUNK_SIZE; i++) {if (!keep_running.load(std::memory_order_relaxed)) break;            double term = 1.0 / (2.0 * i + 1.0);            if (i % 2 != 0) {                term = -term;            }            partial_sum += term;        }        total_pi += partial_sum;        SwitchToFiber(main_fiber);    }    SwitchToFiber(main_fiber);}"
        ]
      ]
    },
    {
      "body": 300,
      "cells": [
        [
          "    for (int i = 0; i < num_fibers; i++) {        getcontext(&fiber_ctxs[i]);        stacks[i] = (char*)malloc(64 * 1024);        fiber_ctxs[i].uc_stack.ss_sp = stacks[i];        fiber_ctxs[i].uc_stack.ss_size = 64 * 1024;        fiber_ctxs[i].uc_link = &main_ctx;        makecontext(&fiber_ctxs[i], fiber_func, 0);    }    while (keep_running) {        for (int i = 0; i < num_fibers; i++) {          if (!keep_running) break;            current_fiber = i;            swapcontext(&main_ctx, &fiber_ctxs[i]);        }    }"
        ]
