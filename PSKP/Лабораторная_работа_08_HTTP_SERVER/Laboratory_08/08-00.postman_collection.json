{
    "info": {
        "name": "ПСКП. Лабораторная работа 08",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "variable": [
        {
            "key": "base_url",
            "value": "http://127.0.0.1:5000"
        }
    ],
    "item": [
        {
            "name": "02. Заголовки",
            "request": {
                "method": "GET",
                "header": [],
                "url": "{{base_url}}/headers"
            },
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "type": "text/javascript",
                        "exec": [
                            "pm.test('Пользовательский заголовок получен', function () {",
                            "    pm.response.to.have.status(200);",
                            "    pm.expect(pm.response.headers.get('X-Lab-Number')).to.equal('08');",
                            "    pm.expect(pm.response.text()).to.include('x-lab-number: 08');",
                            "});"
                        ]
                    }
                }
            ]
        },
        {
            "name": "07. Порционная обработка запроса",
            "request": {
                "method": "POST",
                "header": [
                    {
                        "key": "Content-Type",
                        "value": "text/plain; charset=utf-8"
                    }
                ],
                "url": "{{base_url}}/req-data",
                "body": {
                    "mode": "raw",
                    "raw": "{{long_body}}"
                }
            },
            "event": [
                {
                    "listen": "prerequest",
                    "script": {
                        "type": "text/javascript",
                        "exec": [
                            "pm.variables.set('long_body', 'a'.repeat(262144));"
                        ]
                    }
                },
                {
                    "listen": "test",
                    "script": {
                        "type": "text/javascript",
                        "exec": [
                            "pm.test('Длинное тело прочитано порциями целиком', function () {",
                            "    pm.response.to.have.status(200);",
                            "    const text = pm.response.text();",
                            "    const count = Number(text.match(/Получено порций: (\\d+)/)[1]);",
                            "    pm.expect(count).to.be.above(1);",
                            "    pm.expect(text).to.include('Всего получено: 262144 байт');",
                            "});"
                        ]
                    }
                }
            ]
        },
        {
            "name": "10. JSON",
            "request": {
                "method": "POST",
                "header": [
                    {
                        "key": "Content-Type",
                        "value": "application/json"
                    }
                ],
                "url": "{{base_url}}/json",
                "body": {
                    "mode": "raw",
                    "raw": "{\n    \"__comment\": \" Запрос.Лабораторная работа 8/10\",\n    \"x\": 1,\n    \"y\": 2,\n    \"s\": \"Сообщение\",\n    \"m\": [\n        \"a\",\n        \"b\",\n        \"c\",\n        \"d\"\n    ],\n    \"o\": {\n        \"surname\": \"Иванов\",\n        \"name\": \"Иван\"\n    }\n}"
                }
            },
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "type": "text/javascript",
                        "exec": [
                            "pm.test('JSON соответствует заданию', function () {",
                            "    pm.response.to.have.status(200);",
                            "    pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json');",
                            "    pm.expect(pm.response.json()).to.deep.equal({",
                            "        '__comment': ' Ответ.Лабораторная работа 8/10',",
                            "        'x_plus_y': 3,",
                            "        'Concatination_s_o': 'Сообщение: Иванов, Иван',",
                            "        'Length_m': 4",
                            "    });",
                            "});"
                        ]
                    }
                }
            ]
        },
        {
            "name": "11. XML",
            "request": {
                "method": "POST",
                "header": [
                    {
                        "key": "Content-Type",
                        "value": "application/xml"
                    }
                ],
                "url": "{{base_url}}/xml",
                "body": {
                    "mode": "raw",
                    "raw": "<request id=\"28\">\n    <x value=\"1\"/>\n    <x value=\"2\"/>\n    <m value=\"a\"/>\n    <m value=\"b\"/>\n    <m value=\"c\"/>\n</request>"
                }
            },
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "type": "text/javascript",
                        "exec": [
                            "pm.test('XML содержит сумму и конкатенацию', function () {",
                            "    pm.response.to.have.status(200);",
                            "    pm.expect(pm.response.headers.get('Content-Type')).to.include('application/xml');",
                            "    const text = pm.response.text();",
                            "    pm.expect(text).to.match(/<response id=\"\\d+\" request=\"28\">/);",
                            "    pm.expect(text).to.include('<sum element=\"x\" result=\"3\"/>');",
                            "    pm.expect(text).to.include('<concat element=\"m\" result=\"abc\"/>');",
                            "    pm.expect(text).to.include('</response>');",
                            "});"
                        ]
                    }
                }
            ]
        },
        {
            "name": "12. Количество файлов",
            "request": {
                "method": "GET",
                "header": [],
                "url": "{{base_url}}/files"
            },
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "type": "text/javascript",
                        "exec": [
                            "pm.test('Заголовок содержит количество файлов', function () {",
                            "    pm.response.to.have.status(200);",
                            "    const count = pm.response.headers.get('X-static-files-count');",
                            "    pm.expect(count).to.match(/^\\d+$/);",
                            "    pm.expect(Number(count)).to.be.at.least(1);",
                            "    pm.expect(pm.response.text()).to.include(': ' + count);",
                            "});"
                        ]
                    }
                }
            ]
        }
    ]
}
